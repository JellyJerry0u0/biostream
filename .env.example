## Root env for docker compose
## Copy to `.env` and fill real values.

# Required (auth)
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional AI keys
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Qdrant / embedding
QDRANT_COLLECTION=biostream_corpus_v1
QDRANT_QUANT_COLLECTION=quant_evidence
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Report / coach options
COACH_LLM_MODEL=gemini-2.5-flash
REPORT_DEBUG=0
# 사용자당 동시 생활습관 최대 개수 (백엔드 committed-actions, 기본 12)
MAX_ACTIVE_COMMITTED_HABITS=12

# External image generation API (optional)
# Preferred: base URL for GPU FastAPI (e.g. https://gpu.example.com)
IMAGE_GENERATION_BASE_URL=
# Backward compatibility: full URL style (e.g. https://gpu.example.com/generate)
IMAGE_GENERATION_API_URL=
IMAGE_GENERATION_API_KEY=
# skin-edit max_side: 비우면 미전송(레터박스 완화). 필요 시 1024
# IMAGE_GENERATION_SKIN_EDIT_MAX_SIDE=
# GPU 와 동일 전처리(기본 gpu_match): /generate=FADING 정사각+BICUBIC, /skin-edit=SDXL 흰 캔버스+LANCZOS
# IMAGE_PREPROCESS_MODE=gpu_match
# IMAGE_PREPROCESS_FADING_SIZE=512
# 캔버스 한 변(1024). IMAGE_GENERATION_SKIN_EDIT_MAX_SIDE 를 쓰면 그 값이 우선
# IMAGE_PREPROCESS_SDXL_CANVAS=1024
# 예전: legacy_cover | diffusers_vae
# IMAGE_PREPROCESS_MAX_SIDE= / IMAGE_PREPROCESS_VAE_SCALE= (diffusers_vae 전용)
# legacy_cover 전용: 반반 비교용 원본만 추가 중앙 줌. 예: IMAGE_COMPARE_CENTER_ZOOM=0.78
# IMAGE_COMPARE_CENTER_ZOOM=0.78

# Notion export (optional)
ENABLE_NOTION_EXPORT=true
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_FORMAT_MODE=manual
