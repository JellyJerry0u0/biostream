## Backend local env example
## Copy to `backend/.env` and fill real values.

# Required
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/biostream
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional AI keys
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Qdrant / embedding
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=biostream_corpus_v1
QDRANT_QUANT_COLLECTION=quant_evidence
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Report / coach options
COACH_LLM_MODEL=gemini-2.5-flash
REPORT_DEBUG=0

# External image generation API (optional)
IMAGE_GENERATION_API_URL=
IMAGE_GENERATION_API_KEY=

# Notion export (optional)
ENABLE_NOTION_EXPORT=true
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_FORMAT_MODE=manual
