## Backend local env example
## Copy to `backend/.env` and fill real values.

# Required
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/biostream
JWT_SECRET_KEY=replace-with-a-long-random-secret

# 공개 API 절대 URL (이미지 링크 등). 비우면 각 HTTP 요청의 Host를 사용해
# 앱 개발자 설정(예: http://192.168.x.x:8080)과 자동으로 맞춰짐.
# 리버스 프록시 뒤에서는 여기에 외부 도메인을 넣는 것이 안전함.
# 예: http://192.168.0.10:8080
API_BASE_ORIGIN=

# Optional AI keys
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Qdrant / embedding
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=biostream_corpus_v1
QDRANT_QUANT_COLLECTION=quant_evidence
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Report / coach options
COACH_LLM_MODEL=gemini-2.5-flash
REPORT_DEBUG=0

# 사용자당 동시에 유지할 수 있는 생활습관(committed action) 최대 개수 (1~50, 기본 12)
MAX_ACTIVE_COMMITTED_HABITS=12

# External image generation API (optional)
# GPU 루트만 (끝에 /generate 나 /skin-edit 붙이지 말 것 — 코드가 /generate 등을 붙임)
# 예: https://xxxxx-8000.proxy.runpod.net
#
# 백엔드를 docker compose 로 띄우고 GPU는 맥/윈도우 **호스트**에서 돌릴 때:
#   http://127.0.0.1:8000 같은 주소는 컨테이너 **자신**을 가리켜 연결이 안 됩니다.
#   → http://host.docker.internal:8000 (Docker Desktop) 또는 호스트 LAN IP 사용.
# 브라우저에서 GPU /health 가 살아도, 백엔드 컨테이너에서의 주소·POST 경로(/generate)·API 키가 맞아야 생성됩니다.
IMAGE_GENERATION_BASE_URL=
# Backward compatibility: full URL style (e.g. https://gpu.example.com/generate)
IMAGE_GENERATION_API_URL=
# GPU에 Bearer가 필요할 때만 설정. api_here 같은 플레이스홀더는 보내지 않음.
IMAGE_GENERATION_API_KEY=
# FastAPI 라우트가 다르면 오버라이드 (기본 /generate, /skin-edit)
# IMAGE_GENERATION_PATH_GENERATE=/generate
# IMAGE_GENERATION_PATH_SKIN_EDIT=/skin-edit
# skin-edit multipart 의 max_side. 비우거나 omit → 필드 미전송(/docs 에서 비운 것과 유사, 흰 레터박스 완화). 필요 시 1024
# IMAGE_GENERATION_SKIN_EDIT_MAX_SIDE=
# GPU FADING+SDXL 캔버스 맞춤(기본 gpu_match). FADING 크기·캔버스: IMAGE_PREPROCESS_FADING_SIZE, IMAGE_PREPROCESS_SDXL_CANVAS
# IMAGE_PREPROCESS_MODE=gpu_match
# legacy_cover | diffusers_vae
# IMAGE_PREPROCESS_MAX_SIDE= / IMAGE_PREPROCESS_VAE_SCALE=
# legacy_cover 전용: 반반 비교 원본 중앙 줌 (1.0=없음)
# IMAGE_COMPARE_CENTER_ZOOM=0.78

# Notion export (optional)
ENABLE_NOTION_EXPORT=true
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_FORMAT_MODE=manual
