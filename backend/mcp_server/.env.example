# 환경 변수 설정 예시
# 프로덕션 환경에서는 반드시 안전하게 관리하세요

# MCP 서버 시크릿 키 (JWT 서명용)
# 강력한 랜덤 문자열 사용 권장
MCP_SECRET_KEY=your-production-secret-key-change-this

# 암호화 키 (AES-256용)
# 32바이트 (256비트) 키 사용
MCP_ENCRYPTION_KEY=your-production-encryption-key-32bytes

# 데이터베이스 연결
DATABASE_URL=postgresql://user:password@localhost:5432/biostream

# 로그 레벨
LOG_LEVEL=INFO

# 감사 로그 저장 경로
AUDIT_LOG_PATH=./logs/audit.log

# 자동 동의 승인 (개발 환경에만 사용)
AUTO_APPROVE_LOW_RISK=false

# 속도 제한 설정
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_DATA_VOLUME_MB=10

# 세션 설정
SESSION_EXPIRY_MINUTES=60
TOKEN_EXPIRY_MINUTES=15
