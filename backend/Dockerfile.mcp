FROM python:3.11-slim

WORKDIR /app

# DB 연결 및 AI 로직을 위한 필수 패키지 설치
RUN apt-get update && apt-get install -y libpq-dev build-essential && rm -rf /var/lib/apt/lists/*

# MCP 서버의 requirements.txt 설치
COPY mcp_server/requirements.txt /app/mcp_server/requirements.txt
RUN pip install --no-cache-dir -r /app/mcp_server/requirements.txt

# Backend API의 requirements.txt도 설치 (models 등 공통 의존성)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# 전체 backend 디렉토리 복사 (app, mcp_server 모두 포함)
COPY . /app/

# PYTHONPATH 설정 (app 디렉토리를 모듈 경로에 추가)
ENV PYTHONPATH=/app:$PYTHONPATH

# MCP 서버 실행 (FastAPI와 별도로 실행됨)
CMD ["python", "-m", "mcp_server.server"]